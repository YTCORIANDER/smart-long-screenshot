{
  "manifest_version": 3,
  "name": "Smart Long Screenshot",
  "version": "1.0.30",
  "description": "Capture long screenshots of pages and nested scrollable containers.",
  "permissions": [
    "activeTab",
    "scripting",
    "tabs",
    "downloads",
    "storage"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  }
}
